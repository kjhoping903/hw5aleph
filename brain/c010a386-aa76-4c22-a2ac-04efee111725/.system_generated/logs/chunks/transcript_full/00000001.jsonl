{"step_index":65,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T06:25:09Z","input_tokens":2294,"cache_read_tokens":57464,"output_tokens":1231,"tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nT05 고정 검사 실행기 (Fixed Checks Test Runner)\n모든 10개 검사를 실행하고 결과를 콘솔 및 evidence/test_run_result.json 에 기록합니다.\n\"\"\"\n\nimport unittest\nimport json\nimport os\nimport sys\nfrom datetime import datetime, timezone\n\nfrom tests.test_fixed import TestMultiLLMOrchestratorFixed\n\n\ndef run_fixed_checks(output_json_path=\"evidence/test_run_result.json\"):\n    suite = unittest.TestSuite()\n    test_methods = [\n        \"test_T05_CHK_01_primary_success\",\n        \"test_T05_CHK_02_failover_on_rate_limit_429\",\n        \"test_T05_CHK_03_failover_on_timeout\",\n        \"test_T05_CHK_04_graceful_degradation_when_all_fail\",\n        \"test_T05_CHK_05_markdown_json_schema_parsing\",\n        \"test_T05_CHK_06_edge_case_null_empty_input\",\n        \"test_T05_CHK_07_consensus_evaluation\",\n        \"test_T05_CHK_08_budget_guard\",\n        \"test_T05_CHK_09_pii_secret_sanitizer\",\n        \"test_T05_CHK_10_audit_trace_telemetry\"\n    ]\n\n    for method in test_methods:\n        suite.addTest(TestMultiLLMOrchestratorFixed(method))\n\n    print(\"=\" * 60)\n    print(\"▶ T05 고정 검사 10개 실행 시작 (10 Fixed Checks)\")\n    print(\"=\" * 60)\n\n    results = []\n    passed_count = 0\n    failed_count = 0\n    first_failing_id = None\n\n    for idx, method in enumerate(test_methods, start=1):\n        check_id = f\"T05-CHK-{idx:02d}\"\n        single_suite = unittest.TestSuite([TestMultiLLMOrchestratorFixed(method)])\n        runner = unittest.TextTestRunner(verbosity=0, stream=open(os.devnull, 'w'))\n        result = runner.run(single_suite)\n\n        if result.wasSuccessful():\n            status = \"PASS\"\n            passed_count += 1\n            error_message = None\n            print(f\"[{status}] {check_id}: {method}\")\n        else:\n            status = \"FAIL\"\n            failed_count += 1\n            if result.failures:\n                error_message = result.failures[0][1]\n            elif result.errors:\n                error_message = result.errors[0][1]\n            else:\n                error_message = \"Unknown failure\"\n            \n            if first_failing_id is None:\n                first_failing_id = check_id\n            print(f\"[{status}] {check_id}: {method} --> FAIL\")\n\n        results.append({\n            \"check_id\": check_id,\n            \"method\": method,\n            \"status\": status,\n            \"error_summary\": error_message.strip().splitlines()[-1] if error_message else None\n        })\n\n    print(\"-\" * 60)\n    print(f\"총 검사: {len(test_methods)} | 통과(PASS): {passed_count} | 실패(FAIL): {failed_count}\")\n    if first_failing_id:\n        print(f\"첫 번째 실패 검사 ID: {first_failing_id}\")\n    print(\"=\" * 60)\n\n    summary_data = {\n        \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n        \"total_checks\": len(test_methods),\n        \"passed_count\": passed_count,\n        \"failed_count\": failed_count,\n        \"first_failing_id\": first_failing_id,\n        \"all_passed\": (passed_count == len(test_methods)),\n        \"checks\": results\n    }\n\n    if output_json_path:\n        os.makedirs(os.path.dirname(output_json_path), exist_ok=True)\n        with open(output_json_path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(summary_data, f, indent=2, ensure_ascii=False)\n        print(f\"검사 결과 저장 완료: {output_json_path}\")\n\n    return summary_data\n\n\nif __name__ == \"__main__\":\n    res = run_fixed_checks()\n    if not res[\"all_passed\"]:\n        sys.exit(1)\n    sys.exit(0)\n","Description":"Create run_tests.py test runner script","Overwrite":true,"TargetFile":"C:\\Users\\User\\Desktop\\sep13\\m5d2\\run_tests.py","toolAction":"Creating run_tests.py","toolSummary":"Test runner script"}}]}
