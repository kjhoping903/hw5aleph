{"step_index":107,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T06:28:55Z","input_tokens":3977,"cache_read_tokens":71523,"output_tokens":2782,"thinking":"Analyzing remaining tasks to ensure complete functionality; focusing on `resolve_consensus`, budget limit checks, and audit context implementation within the orchestrator. Examining test cases, specifically evaluating requirements for the consensus evaluation check within `tests/test_fixed.py`. The initial test case suggests a need to verify consensus resolution with specific evaluation model outputs.\n\n\nEvaluating consensus resolution confirms that the system correctly identifies critical severity when a model reports it, even with disagreement between models. Further testing demonstrates the budget limit implementation correctly restricts API calls; subsequent calls exceed the budget and return the expected status, with the total call count remaining constant. This budget behavior suggests a design where the call counter is not incremented when the budget is exceeded.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nMulti-LLM Orchestrator 핵심 모듈 (AI B 구현 완성본)\n과제 4 연계 다중 LLM 장애 회복, 합의 판정, 예산 가드, 스키마 검증, 실행 추적 제공\n\"\"\"\n\nimport json\nimport re\nimport time\nimport uuid\nfrom collections import Counter\nfrom datetime import datetime, timezone\nfrom typing import Dict, Any, Optional, Tuple, List\n\nfrom src.models import (\n    BaseLLMProvider,\n    MockPrimaryLLM,\n    MockFallbackLLM,\n    LLMError,\n    RateLimitError,\n    TimeoutError,\n    ServiceUnavailableError\n)\nfrom src.sanitizer import sanitize_sensitive_data\n\n\nclass MultiLLMOrchestrator:\n    def __init__(\n        self,\n        primary_llm: BaseLLMProvider,\n        fallback_llm: BaseLLMProvider,\n        call_budget_limit: Optional[int] = 10\n    ):\n        self.primary_llm = primary_llm\n        self.fallback_llm = fallback_llm\n        self.call_budget_limit = call_budget_limit\n        self.total_call_count = 0\n\n    def analyze_signal(\n        self,\n        signal_data: Optional[Dict[str, Any]],\n        context: Optional[Dict[str, Any]] = None\n    ) -> Dict[str, Any]:\n        start_time = time.time()\n\n        # T05-CHK-06: 경계값 방어 (None 또는 빈 딕셔너리)\n        if not signal_data or len(signal_data) == 0:\n            return {\n                \"status\": \"INVALID_INPUT\",\n                \"error_code\": \"ERR_EMPTY_SIGNAL\",\n                \"message\": \"신호 데이터가 비어있거나 올바르지 않습니다.\"\n            }\n\n        # T05-CHK-08: 호출 예산 상한(call_budget_limit) 보호\n        if self.call_budget_limit is not None and self.total_call_count >= self.call_budget_limit:\n            return {\n                \"status\": \"BUDGET_EXCEEDED\",\n                \"message\": f\"호출 예산 상한({self.call_budget_limit}회)에 도달하여 추가 호출이 차단되었습니다.\",\n                \"total_call_count\": self.total_call_count\n            }\n\n        error_history = []\n        fallback_triggered = False\n        metrics = {\"fallback_latency_ms\": 0}\n\n        prompt = f\"Analyze reading: {signal_data}\"\n\n        response: Dict[str, Any]\n\n        # 1차 시도: Primary LLM\n        try:\n            self.total_call_count += 1\n            res = self.primary_llm.generate(prompt)\n            response = {\n                \"status\": \"SUCCESS\",\n                \"provider_used\": \"primary\",\n                \"fallback_triggered\": False,\n                \"error_history\": [],\n                \"metrics\": {\"latency_ms\": int((time.time() - start_time) * 1000)},\n                \"result\": res\n            }\n        except (RateLimitError, TimeoutError, ServiceUnavailableError, Exception) as pe:\n            error_history.append(f\"primary: {type(pe).__name__}({str(pe)})\")\n            fallback_triggered = True\n\n            # 2차 시도: Fallback LLM\n            fb_start = time.time()\n            try:\n                self.total_call_count += 1\n                res = self.fallback_llm.generate(prompt)\n                metrics[\"fallback_latency_ms\"] = int((time.time() - fb_start) * 1000)\n                response = {\n                    \"status\": \"SUCCESS\",\n                    \"provider_used\": \"fallback\",\n                    \"fallback_triggered\": True,\n                    \"error_history\": error_history,\n                    \"metrics\": metrics,\n                    \"result\": res\n                }\n            except Exception as fe:\n                error_history.append(f\"fallback: {type(fe).__name__}({str(fe)})\")\n\n                # T05-CHK-04: 모든 LLM 실패 시 Graceful Degradation (로컬 휴리스틱 진단)\n                response = {\n                    \"status\": \"DEGRADED\",\n                    \"provider_used\": \"local_heuristic\",\n                    \"fallback_triggered\": True,\n                    \"error_history\": error_history,\n                    \"metrics\": metrics,\n                    \"result\": {\n                        \"summary\": \"외부 LLM 분석 일시 불가 - 직전 정상 상태 유지 권고\",\n                        \"local_fallback_guide\": \"장애 격리 후 수동 점검 요망\",\n                        \"action_required\": True\n                    }\n                }\n\n        # T05-CHK-10: 실행 감사 추적(audit_trace) 메타데이터 주입\n        if context is not None:\n            duration_ms = int((time.time() - start_time) * 1000)\n            response[\"audit_trace\"] = {\n                \"trace_id\": str(uuid.uuid4()),\n                \"session_id\": context.get(\"session_id\", \"UNKNOWN\"),\n                \"commit_hash\": context.get(\"commit_hash\", \"UNKNOWN\"),\n                \"timestamp\": datetime.now(timezone.utc).isoformat(),\n                \"duration_ms\": max(0, duration_ms)\n            }\n\n        return response\n\n    def parse_and_validate_response(self, raw_text: str) -> Tuple[Dict[str, Any], bool]:\n        \"\"\"T05-CHK-05: 마크다운 코드블록 정규화 및 JSON 파싱\"\"\"\n        cleaned = raw_text.strip()\n        match = re.search(r\"```(?:json)?\\s*([\\s\\S]*?)\\s*```\", cleaned)\n        if match:\n            cleaned = match.group(1).strip()\n\n        try:\n            parsed = json.loads(cleaned)\n            is_valid = isinstance(parsed, dict) and \"severity\" in parsed and \"summary\" in parsed\n            return parsed, is_valid\n        except json.JSONDecodeError:\n            return {}, False\n\n    def resolve_consensus(self, evaluations: List[Dict[str, Any]]) -> Dict[str, Any]:\n        \"\"\"\n        T05-CHK-07: 다중 LLM 앙상블 합의 및 위험도 안전 우선 해결\n        - 우선순위: CRITICAL > WARNING > INFO / LOW\n        - 어느 한 모델이라도 CRITICAL을 제시할 경우 안전 우선 원칙에 따라 CRITICAL로 에스컬레이션\n        \"\"\"\n        if not evaluations:\n            return {\n                \"resolved_severity\": \"UNKNOWN\",\n                \"models_evaluated\": 0,\n                \"consensus_agreement_rate\": 0.0,\n                \"safety_escalated\": False\n            }\n\n        severities = [ev.get(\"severity\", \"INFO\") for ev in evaluations]\n        total_models = len(evaluations)\n\n        # 빈도 수 집계\n        counts = Counter(severities)\n        most_common_count = counts.most_common(1)[0][1]\n        agreement_rate = most_common_count / total_models\n\n        # 안전 우선 규칙 판정\n        severity_rank = {\"CRITICAL\": 3, \"WARNING\": 2, \"LOW\": 1, \"INFO\": 1}\n        highest_severity = max(severities, key=lambda s: severity_rank.get(s, 0))\n\n        safety_escalated = (\"CRITICAL\" in severities and any(s != \"CRITICAL\" for s in severities))\n\n        return {\n            \"resolved_severity\": highest_severity,\n            \"models_evaluated\": total_models,\n            \"consensus_agreement_rate\": agreement_rate,\n            \"safety_escalated\": safety_escalated,\n            \"severities_observed\": severities\n        }\n","Description":"Complete MultiLLMOrchestrator for AI B session","Overwrite":true,"TargetFile":"C:\\Users\\User\\Desktop\\sep13\\m5d2\\src\\orchestrator.py","toolAction":"Updating orchestrator.py","toolSummary":"AI B orchestrator implementation"}}]}
