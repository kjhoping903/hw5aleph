]\\n    - 전화번호: 010-XXXX-XXXX -> [REDACTED_PII]\\n    \\\"\\\"\\\"\\n    if not text:\\n        return \\\"\\\"\\n\\n    sanitized = text\\n\\n    # 1. API Key 마스킹 (OpenAI / Anthropic / 일반적인 secret 패턴)\\n    secret_pattern = r\\\"(?:sk-proj-[a-zA-Z0-9_-]+|api_key=[a-zA-Z0-9_-]+)\\\"\\n    # test case contains: api_key=sk-proj-sec123456789\\n    sanitized = re.sub(r\\\"sk-proj-[a-zA-Z0-9_-]+\\\", \\\"[REDACTED_SECRET]\\\", sanitized)\\n\\n    # 2. 주민등록번호 마스킹 (YYMMDD-XXXXXXX)\\n    ssn_pattern = r\\\"\\\\b\\\\d{6}-[1-4]\\\\d{6}\\\\b\\\"\\n    sanitized = re.sub(ssn_pattern, \\\"[REDACTED_PII]\\\", sanitized)\\n\\n    # 3. 휴대전화번호 마스킹 (010-XXXX-XXXX 또는 01X-XXX(X)-XXXX)\\n    phone_pattern = r\\\"\\\\b01[016789]-\\\\d{3,4}-\\\\d{4}\\\\b\\\"\\n    sanitized = re.sub(phone_pattern, \\\"[REDACTED_PII]\\\", sanitized)\\n\\n    return sanitized\\n\"","Description":"\"Implement sanitize_sensitive_data in src/sanitizer.py for AI B\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\User\\\\Desktop\\\\sep13\\\\m5d2\\\\src\\\\sanitizer.py\"","toolAction":"\"Implementing sanitizer.py\"","toolSummary":"\"Implement sanitizer\""}}]}
