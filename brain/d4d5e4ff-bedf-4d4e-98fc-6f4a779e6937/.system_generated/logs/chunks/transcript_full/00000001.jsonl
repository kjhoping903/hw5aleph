\": \"메모를 조회할 수 없습니다.\"}, 503\n\n    if existing is None:\n        return {\"error\": \"존재하지 않는 메모입니다.\"}, 404\n\n    try:\n        deleted = delete_note(note_id)\n    except psycopg.Error:\n        return {\"error\": \"메모를 삭제할 수 없습니다.\"}, 503\n\n    if not deleted:\n        return {\"error\": \"존재하지 않는 메모입니다.\"}, 404\n\n    return {\"message\": \"메모가 삭제되었습니다.\"}, 200\n","Description":"Create routes/notes.py for note CRUD with validation and auth","Overwrite":true,"TargetFile":"c:\\work\\mini-watch-day03-start\\monitor\\backend\\routes\\notes.py","toolAction":"Creating notes.py","toolSummary":"Create notes route"}}]}
